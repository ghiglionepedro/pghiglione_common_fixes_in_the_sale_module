<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Imagen en vista lista -->
    <record id="view_stock_quant_tree_inherit_image" model="ir.ui.view">
        <field name="name">stock.quant.tree.inherit.image</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="before">
                <field name="product_image" widget="image" class="oe_avatar" style="width:32px;height:32px;"/>
            </xpath>
        </field>
    </record>

</odoo>
