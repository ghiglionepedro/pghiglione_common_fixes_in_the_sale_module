<odoo>
    <record id="view_account_payment_group_form_inherit" model="ir.ui.view">
        <field name="name">account.payment.group.form.inherit.attachments</field>
        <field name="model">account.payment.group</field>
        <field name="inherit_id" ref="account_payment_group.view_account_payment_group_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_view_attachments"
                        type="object"
                        class="oe_highlight"
                        string="Attachments"
                        icon="fa-paperclip"/>
            </xpath>
        </field>
    </record>
</odoo>