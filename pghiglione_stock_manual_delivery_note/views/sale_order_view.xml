<odoo>
    <record id="view_sale_order_tree_manual_delivery_notes" model="ir.ui.view">
        <field name="name">sale.order.tree.manual.delivery.notes</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='state']" position="after">
                <field name="manual_delivery_notes"/>
            </xpath>

        </field>
    </record>
</odoo>