<odoo>
    <record id="view_picking_form_manual_delivery_note" model="ir.ui.view">
        <field name="name">stock.picking.form.manual.delivery.note</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='scheduled_date']" position="after">
                <field name="manual_delivery_note"
                    placeholder="Ej: 0003-00001234"
                    attrs="{
                        'required': [
                            ('picking_type_code','=','outgoing'),
                            ('state','!=','done')
                        ]
                    }"/>
            </xpath>

        </field>
    </record>
    <record id="view_picking_tree_manual_delivery_note" model="ir.ui.view">
        <field name="name">stock.picking.tree.manual.delivery.note</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='origin']" position="after">
                <field name="manual_delivery_note"/>
            </xpath>

        </field>
    </record>
</odoo>