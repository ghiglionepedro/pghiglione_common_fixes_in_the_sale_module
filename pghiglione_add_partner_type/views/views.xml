<odoo>
  <data>
    <record id="pghiglione_add_partner_type_in_sale_list" model="ir.ui.view">
      <field name="name">pghiglione.add.partner.type.in.sale.list</field>
      <field name="model">sale.order</field>
      <field name="inherit_id" ref="sale.view_quotation_tree"/>
      <field name="arch" type="xml">
          <xpath expr="//field[@name='partner_id']" position="after">
            <field name="partner_type" string="Customer Type" readonly="1"/>
        </xpath>
      </field>
  </record>

  </data>
</odoo>